# Application
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/locktest?replicaSet=rs0

# Lock Configuration
LOCK_KEY=job_processor_lock
LOCK_TTL_MS=10000

# Job Configuration
WRITE_JOBS_INTERVAL_MS=200
PROCESS_JOBS_INTERVAL_MS=3000
PROCESS_BATCH_SIZE=5
JOB_PROCESSING_TIME_MIN=500
JOB_PROCESSING_TIME_MAX=2000